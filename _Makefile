# inspired by https://stackoverflow.com/questions/30573481/how-to-write-a-makefile-with-separate-source-and-header-directories

SRC_DIR = src
OBJ_DIR = obj
BIN_DIR = bin
INCLUDE_DIR = include
GEN_DIR = $(INCLUDE_DIR)/generated
IMGUI_DIR = include/imgui

.PHONY: all clean

EXE = $(BIN_DIR)/emu
SHADER_H = $(GEN_DIR)/metal_shaders.generated.h
SHADER_LIB = $(OBJ_DIR)/shaders.metallib

CPP_SRC = $(shell find $(SRC_DIR) -name *.cpp)
OBJC_SRC = $(shell find $(SRC_DIR) -name *.mm)
SHADER_SRC = $(shell find $(SRC_DIR) -name *.metal)
IMGUI_SRC = $(wildcard $(IMGUI_DIR)/*.cpp)
IMGUI_SRC += $(IMGUI_DIR)/backends/imgui_impl_sdl2.cpp $(IMGUI_DIR)/backends/imgui_impl_metal.mm

CPP_OBJ = $(CPP_SRC:$(SRC_DIR)/%.cpp=$(OBJ_DIR)/%.o)
OBJC_OBJ = $(OBJC_SRC:$(SRC_DIR)/%.mm=$(OBJ_DIR)/%.o)
SHADER_OBJ = $(SHADER_SRC:$(SRC_DIR)/%.metal=$(OBJ_DIR)/%.air)
IMGUI_OBJ = $(IMGUI_SRC:$(IMGUI_DIR)/%.cpp=$(OBJ_DIR)/imgui/%.o)

# $(info CPP_SRC is $(CPP_SRC))
# $(info CPP_OBJ is $(CPP_OBJ))
# $(info OBJC_SRC is $(OBJC_SRC))
# $(info OBJC_OBJ is $(OBJC_OBJ))
# $(info SHADER_SRC is $(SHADER_SRC))
# $(info SHADER_OBJ is $(SHADER_OBJ))
$(info IMGUI_SRC is $(IMGUI_SRC))
$(info IMGUI_OBJ is $(IMGUI_OBJ))

CXXFLAGS = -std=c++17 -Iinclude -Iinclude/imgui -Iinclude/imgui/backends -I/usr/local/include/metal-cpp -I/opt/homebrew/include -I/opt/homebrew/include/SDL2
CXXFLAGS += -Wall -Wformat -DNEWMAIN -g -O0

LDFLAGS = -framework Foundation -framework Metal -framework QuartzCore
LDFLAGS += -L/opt/homebrew/lib -Llib -lSDL2

# $(info LDFLAGS is $(LDFLAGS))
# $(info CLFAGS is $(CFLAGS))
# $(info SHADER_LIB is $(SHADER_LIB))
# $(info SHADER_OBJ is $(SHADER_OBJ))
# $(info SHADER_SRC is $(SHADER_SRC))

all: $(SHADER_H) $(EXE) 

.SECONDEXPANSION:
$(EXE): $(CPP_OBJ) $(IMGUI_OBJ)
	@mkdir -p $(@D)
	$(CXX) $(LDFLAGS) $^ -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp $(SHADER_H)
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/imgui/%.o: $(IMGUI_DIR)/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/imgui/%.o: $(IMGUI_DIR)/%.mm
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(CFLAGS) -ObjC++ -fobjc-weak -fobjc-arc -c $< -o $@

$(OBJ_DIR)/%.air: $(SRC_DIR)/%.metal
	@mkdir -p $(@D)
	xcrun -sdk macosx metal -c $< -o $@

$(SHADER_H): $(SHADER_LIB) | $$(dir $$@)
	@mkdir -p $(@D)
	xxd -i $< > $@

$(SHADER_LIB): $(SHADER_OBJ)
	@mkdir -p $(@D)
	xcrun -sdk macosx metallib -o $@ $^

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.mm
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(CFLAGS) -ObjC++ -fobjc-weak -fobjc-arc -c $< -o $@

clean:
	@$(RM) -rv $(BIN_DIR) $(OBJ_DIR)

-include $(OBJ:.o=.d)
